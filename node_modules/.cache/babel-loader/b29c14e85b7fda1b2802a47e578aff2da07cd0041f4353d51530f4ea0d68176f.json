{"ast":null,"code":"export default {\n  name: 'App',\n  data() {\n    return {\n      users: []\n    };\n  },\n  mounted() {\n    // שליחה של בקשה ל-Nest.js\n    fetch('http://localhost:3000/users').then(response => response.json()).then(data => {\n      this.users = data;\n    }).catch(error => console.log(error));\n  }\n};","map":{"version":3,"names":["name","data","users","mounted","fetch","then","response","json","catch","error","console","log"],"sources":["D:\\hindy\\practicum\\Nest\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <h1 class=\"title\">Users List</h1>\n    <ul class=\"user-list\">\n      <li v-for=\"user in users\" :key=\"user.id\" class=\"user-item\">\n        <div class=\"user-card\">\n          <h3 class=\"user-name\">{{ user.name }}</h3>\n          <p class=\"user-email\">{{ user.email }}</p>\n        </div>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      users: []\n    };\n  },\n  mounted() {\n    // שליחה של בקשה ל-Nest.js\n    fetch('http://localhost:3000/users')\n      .then(response => response.json())\n      .then(data => {\n        this.users = data;\n      })\n      .catch(error => console.log(error));\n  }\n};\n</script>\n\n<style>\n/* עיצוב הכללי */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: 'Arial', sans-serif;\n  background-color: #f4f7fc;\n  color: #333;\n  padding: 20px;\n}\n\n/* כותרת */\n.title {\n  font-size: 2.5rem;\n  color: #4e4e4e;\n  text-align: center;\n  margin-bottom: 30px;\n}\n\n/* רשימת משתמשים */\n.user-list {\n  list-style-type: none;\n  padding: 0;\n}\n\n.user-item {\n  margin-bottom: 20px;\n}\n\n.user-card {\n  background-color: #ffffff;\n  padding: 20px;\n  border-radius: 10px;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.user-card:hover {\n  transform: translateY(-5px);\n  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);\n}\n\n/* שם המשתמש */\n.user-name {\n  font-size: 1.6rem;\n  font-weight: 600;\n  color: #2c3e50;\n  margin-bottom: 10px;\n}\n\n/* אימייל */\n.user-email {\n  font-size: 1.2rem;\n  color: #7f8c8d;\n  margin-bottom: 10px;\n}\n\n/* עיצוב כללי */\n#app {\n  max-width: 1200px;\n  margin: 0 auto;\n  background-color: #ffffff;\n  border-radius: 10px;\n  padding: 40px;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n}\n</style>\n"],"mappings":"AAeA,eAAe;EACbA,IAAI,EAAE,KAAK;EACXC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE;IACT,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACAC,KAAK,CAAC,6BAA6B,EAChCC,IAAI,CAACC,QAAO,IAAKA,QAAQ,CAACC,IAAI,CAAC,CAAC,EAChCF,IAAI,CAACJ,IAAG,IAAK;MACZ,IAAI,CAACC,KAAI,GAAID,IAAI;IACnB,CAAC,EACAO,KAAK,CAACC,KAAI,IAAKC,OAAO,CAACC,GAAG,CAACF,KAAK,CAAC,CAAC;EACvC;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}