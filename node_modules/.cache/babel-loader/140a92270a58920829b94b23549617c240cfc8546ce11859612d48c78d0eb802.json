n  data() {\n    return {\n      users: []\n    };\n  },\n  mounted() {\n    // שליחה של בקשה ל-Nest.js\n    fetch('http://localhost:3000/users')\n      .then(response => response.json())\n      .then(data => {\n        this.users = data;\n      })\n      .catch(error => console.log(error));\n  }\n};\n</script>\n\n<style>\n/* עיצוב הכללי */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: 'Arial', sans-serif;\n  background-color: #f4f7fc;\n  color: #333;\n  padding: 20px;\n}\n\n/* כותרת */\n.title {\n  font-size: 2.5rem;\n  color: #4e4e4e;\n  text-align: center;\n  margin-bottom: 30px;\n}\n\n/* רשימת משתמשים */\n.user-list {\n  list-style-type: none;\n  padding: 0;\n}\n\n.user-item {\n  margin-bottom: 20px;\n}\n\n.user-card {\n  background-color: #ffffff;\n  padding: 20px;\n  border-radius: 10px;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.user-card:hover {\n  transform: translateY(-5px);\n  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);\n}\n\n/* שם המשתמש */\n.user-name {\n  font-size: 1.6rem;\n  font-weight: 600;\n  color: #2c3e50;\n  margin-bottom: 10px;\n}\n\n/* אימייל */\n.user-email {\n  font-size: 1.2rem;\n  color: #7f8c8d;\n  margin-bottom: 10px;\n}\n\n/* עיצוב כללי */\n#app {\n  max-width: 1200px;\n  margin: 0 auto;\n  background-color: #ffffff;\n  border-radius: 10px;\n  padding: 40px;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n}\n</style>\n"],"mappings":";;EACOA,EAAE,EAAC;AAAK;;EAEPC,KAAK,EAAC;AAAW;;EAEZA,KAAK,EAAC;AAAW;;EAChBA,KAAK,EAAC;AAAW;;EAClBA,KAAK,EAAC;AAAY;;uBAN7BC,mBAAA,CAUM,OAVNC,UAUM,G,0BATJC,mBAAA,CAAiC;IAA7BH,KAAK,EAAC;EAAO,GAAC,YAAU,qBAC5BG,mBAAA,CAOK,MAPLC,UAOK,I,kBANHH,mBAAA,CAKKI,SAAA,QAAAC,WAAA,CALcC,KAAA,CAAAC,KAAK,EAAbC,IAAI;yBAAfR,mBAAA,CAKK;MALsBS,GAAG,EAAED,IAAI,CAACV,EAAE;MAAEC,KAAK,EAAC;QAC7CG,mBAAA,CAGM,OAHNQ,UAGM,GAFJR,mBAAA,CAA0C,MAA1CS,UAA0C,EAAAC,gBAAA,CAAjBJ,IAAI,CAACK,IAAI,kBAClCX,mBAAA,CAA0C,KAA1CY,UAA0C,EAAAF,gBAAA,C